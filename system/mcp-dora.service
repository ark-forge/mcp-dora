[Unit]
Description=MCP DORA Compliance Scanner (Python Streamable HTTP)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/claude-ceo/workspace/mcp-servers/dora
ExecStart=/opt/claude-ceo/workspace/mcp-servers/dora/.venv/bin/python server.py --http
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
